@api = http://localhost:5080/api
@projectId = 00000000-0000-0000-0000-000000000000
@taskId = 00000000-0000-0000-0000-000000000000

### Rejestracja (loguje od razu)
POST {{api}}/auth/register
Content-Type: application/json

{ "email": "ola@example.com", "password": "bardzo-tajne-1" }

### Logowanie
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "ola@example.com", "password": "bardzo-tajne-1" }

### Kim jestem
GET {{api}}/auth/me

### Moje projekty z licznikami
GET {{api}}/projects

### Nowy projekt
POST {{api}}/projects
Content-Type: application/json

{ "name": "Dom" }

### Zadania projektu (filtr + strona)
GET {{api}}/projects/{{projectId}}/tasks?status=Todo&page=1&pageSize=20

### Nowe zadanie w projekcie
POST {{api}}/projects/{{projectId}}/tasks
Content-Type: application/json

{ "title": "Kupić mleko" }

### Rozpocznij / ukończ / wznów
POST {{api}}/tasks/{{taskId}}/start

###
POST {{api}}/tasks/{{taskId}}/complete

###
POST {{api}}/tasks/{{taskId}}/reopen

### Zmień tytuł
PUT {{api}}/tasks/{{taskId}}/title
Content-Type: application/json

{ "title": "Kupić 2 mleka" }

### Archiwizuj projekt
POST {{api}}/projects/{{projectId}}/archive

### Wyloguj
POST {{api}}/auth/logout